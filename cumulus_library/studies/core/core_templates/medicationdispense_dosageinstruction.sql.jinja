{% import 'unnest_utils.jinja' as unnest_utils %}
{% import 'dosage_utils.jinja' as dosage_utils %}

{#- US Core marks MedicationDispense.dosageInstruction must support, along with
    its text, timing, route and doseAndRate.dose[x] children. dosageInstruction is
    0..*, so it lives here rather than fanning out core__medicationdispense.

    Grain is one row per (dispense, dosageInstruction, doseAndRate) - a tapering
    dispense records one instruction per dose level. 'row' is the dosageInstruction
    position in the source array, and is the join key into
    core__medicationdispense_dn_dosage_route. #}

{%- set di = schema["medicationdispense"]["dosageInstruction"] %}
{%- set repeat = di["timing"]["repeat"] %}
{%- set dose = di["doseAndRate"] %}
{%- set quantity = dose["doseQuantity"] %}
{%- set low = dose["doseRange"]["low"] %}
{%- set high = dose["doseRange"]["high"] %}
{%- set has_dose = (
        quantity["value"] or quantity["unit"] or quantity["system"] or quantity["code"]
        or low["value"] or low["unit"] or low["system"] or low["code"]
        or high["value"] or high["unit"] or high["system"] or high["code"]
    )
%}
{%- set has_dosage = (
        di["text"]
        or di["route"]["text"]
        or di["timing"]["code"]["text"]
        or repeat["frequency"]
        or repeat["period"]
        or repeat["periodUnit"]
        or repeat["boundsPeriod"]["start"]
        or repeat["boundsPeriod"]["end"]
        or has_dose
    )
%}

CREATE TABLE core__medicationdispense_dosageinstruction AS (
    {%- if has_dosage %}
    WITH

    parent AS (
        SELECT DISTINCT
            md.id,
            md.medicationdispense_ref,
            md.subject_ref,
            md.encounter_ref,
            md.whenHandedOver,
            md.whenHandedOver_month
        FROM core__medicationdispense AS md
    ),

    dosage_rows AS (
        {{ unnest_utils.flatten('medicationdispense', 'dosageInstruction') }}
    ),

    dosage_cols AS (
        SELECT
            d.id,
            d.row,
            {% if di["text"] -%}
            d.dosageInstruction.text AS dosage_text,
            {%- else -%}
            cast(NULL AS varchar) AS dosage_text,
            {%- endif %}
            {% if di["route"]["text"] -%}
            d.dosageInstruction.route.text AS dosage_route_text,
            {%- else -%}
            cast(NULL AS varchar) AS dosage_route_text,
            {%- endif %}
            {% if di["timing"]["code"]["text"] -%}
            d.dosageInstruction.timing.code.text AS dosage_timing_text,
            {%- else -%}
            cast(NULL AS varchar) AS dosage_timing_text,
            {%- endif %}
            {% if repeat["frequency"] -%}
            cast(d.dosageInstruction.timing.repeat.frequency AS bigint)
                AS dosage_timing_frequency,
            {%- else -%}
            cast(NULL AS bigint) AS dosage_timing_frequency,
            {%- endif %}
            {% if repeat["period"] -%}
            cast(d.dosageInstruction.timing.repeat.period AS double) AS dosage_timing_period,
            {%- else -%}
            cast(NULL AS double) AS dosage_timing_period,
            {%- endif %}
            {% if repeat["periodUnit"] -%}
            d.dosageInstruction.timing.repeat.periodUnit AS dosage_timing_period_unit,
            {%- else -%}
            cast(NULL AS varchar) AS dosage_timing_period_unit,
            {%- endif %}
            {% if repeat["boundsPeriod"]["start"] -%}
            cast(
                from_iso8601_timestamp(d.dosageInstruction.timing.repeat.boundsPeriod.start)
                AS date
            ) AS dosage_timing_bounds_start,
            {%- else -%}
            cast(NULL AS date) AS dosage_timing_bounds_start,
            {%- endif %}
            {% if repeat["boundsPeriod"]["end"] -%}
            cast(
                from_iso8601_timestamp(d.dosageInstruction.timing.repeat.boundsPeriod."end")
                AS date
            ) AS dosage_timing_bounds_end
            {%- else -%}
            cast(NULL AS date) AS dosage_timing_bounds_end
            {%- endif %}
        FROM dosage_rows AS d
    ),

    dose_rows AS (
        {%- if has_dose %}
        SELECT DISTINCT
            d.id,
            d.row,
            {{- dosage_utils.dose_cols('u.dose_and_rate', dose) }}
        FROM
            dosage_rows AS d,
            unnest(d.dosageInstruction.doseAndRate) AS u (dose_and_rate) --noqa
        {%- else %}
        SELECT
            'x' AS id,
            cast(NULL AS bigint) AS row,
            {{- dosage_utils.empty_dose_cols() }}
        WHERE 1 = 0 -- no dose data in this dataset
        {%- endif %}
    )

    SELECT
        dc.id,
        dc.row,

        dc.dosage_text,

        dr.code AS dosage_route_code,
        dr.system AS dosage_route_system,
        dr.display AS dosage_route_display,
        dc.dosage_route_text,

        dc.dosage_timing_text,
        dc.dosage_timing_frequency,
        dc.dosage_timing_period,
        dc.dosage_timing_period_unit,
        dc.dosage_timing_bounds_start,
        dc.dosage_timing_bounds_end,

        {{- dosage_utils.select_dose_cols('dq') }},

        p.whenHandedOver,
        p.whenHandedOver_month,

        p.medicationdispense_ref,
        p.subject_ref,
        p.encounter_ref
    FROM dosage_cols AS dc
    INNER JOIN parent AS p ON dc.id = p.id
    LEFT JOIN dose_rows AS dq ON dc.id = dq.id AND dc.row = dq.row
    LEFT JOIN core__medicationdispense_dn_dosage_route AS dr
        ON dc.id = dr.id AND dc.row = dr.row

    {%- else %}
    SELECT
        'x' AS id,
        cast(NULL AS bigint) AS row,
        'x' AS dosage_text,
        'x' AS dosage_route_code,
        'x' AS dosage_route_system,
        'x' AS dosage_route_display,
        'x' AS dosage_route_text,
        'x' AS dosage_timing_text,
        cast(NULL AS bigint) AS dosage_timing_frequency,
        cast(NULL AS double) AS dosage_timing_period,
        'x' AS dosage_timing_period_unit,
        cast(NULL AS date) AS dosage_timing_bounds_start,
        cast(NULL AS date) AS dosage_timing_bounds_end,
        {{- dosage_utils.empty_dose_cols() }},
        cast(NULL AS timestamp) AS whenHandedOver,
        cast(NULL AS date) AS whenHandedOver_month,
        'x' AS medicationdispense_ref,
        'x' AS subject_ref,
        'x' AS encounter_ref
    WHERE 1 = 0 -- empty table
    {%- endif %}
);
